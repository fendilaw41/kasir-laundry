# ==========================================
# BACKEND API ENDPOINT (NestJS)
# ==========================================
VITE_API_URL=http://localhost:3000/api

# ==========================================
# BRAND & NAMA APLIKASI (Ubah nama brand di sini)
# ==========================================
VITE_APP_NAME="Klinvo"
VITE_ENABLE_AUTO_SYNC=true
# Background sync interval: 10 menit (600000 ms) agar sangat hemat resource & tidak lemot
VITE_SYNC_INTERVAL_MS=600000

# ==========================================
# PUBLIC TRACKING URL (Cek Status Pesanan)
# ==========================================
VITE_PUBLIC_TRACKING_URL=http://localhost:5173

VITE_APP_URL=http://localhost:5173

# ==========================================
# SUBSCRIPTION & PLAN CONFIG
# ==========================================
VITE_FEATURE_SUBSCRIPTION_ENABLED=true
VITE_SHOW_UPGRADE_BANNER=true
VITE_BILLING_WHATSAPP_NUMBER="6281234567890"
