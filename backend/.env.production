# ==========================================
# SYNC & STORE CONFIGURATION
# ==========================================
DEFAULT_STORE_NAME="KASIR LAUNDRY"

# ==========================================
# CHAT & MULTI-STORE CONFIGURATION
# ==========================================
ENABLE_CROSS_STORE_CHAT=false

# ==========================================
# STORAGE DRIVER (LOCAL vs S3/MINIO)
# ==========================================
# Pilihan: 'local' | 's3'
STORAGE_DRIVER="local"

# Konfigurasi S3 / MinIO (jika STORAGE_DRIVER=s3)
