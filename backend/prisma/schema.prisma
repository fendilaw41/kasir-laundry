generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  city      String?
  phone     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users         User[]
  products      Product[]
  orders        Order[]
  pelanggan     Pelanggan[]
  inventory     Inventory[]
  settings      Settings?
  syncLogs      SyncLog[]
  conversations Conversation[]
}

model User {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  username  String
  password  String // hash bcrypt
  fullname  String
  role      String // 'owner' | 'kasir'
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orders               Order[]
  createdConversations Conversation[]       @relation("CreatedConversations")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]

  @@unique([storeId, username])
  @@index([storeId, updatedAt])
}

model Product {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  code      String?
  category  String?
  name      String
  price     Int
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([storeId, updatedAt])
}

model Pelanggan {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  nama      String
  hp        String
  alamat    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orders Order[]

  @@index([storeId, updatedAt])
}

model Inventory {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  nama      String
  stok      Int       @default(0)
  qty       Int       @default(0)
  unit      String?
  status    String?
  createdBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([storeId, updatedAt])
}

model Order {
  id            String     @id @default(uuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id])
  invoiceId     String
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  pelangganId   String?
  pelanggan     Pelanggan? @relation(fields: [pelangganId], references: [id])
  total         Int
  diskon        Int        @default(0)
  bayar         Int        @default(0)
  kembalian     Int        @default(0)
  metodeBayar   String?
  estimasi      String?
  tipeLayanan   String?
  isPriority    Boolean    @default(false)
  statusBayar   String?
  status        String?
  catatan       String?
  inventoryUsed Json?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?  @db.Timestamptz(3)

  items OrderItem[]

  @@unique([storeId, invoiceId])
  @@index([storeId, updatedAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Float
  price     Int
  subtotal  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

model Settings {
  storeId        String   @id
  store          Store    @relation(fields: [storeId], references: [id])
  namaLaundry    String?
  alamat         String?
  kota           String?
  telepon        String?
  jamBuka        String?
  menerimaCucian Boolean  @default(true)
  headerStruk    String?
  footerStruk    String?
  storageDriver  String? // 'local' | 's3'
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

model SyncLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  tableName  String // 'Order' | 'User' | 'Product' | 'Settings' | 'Pelanggan'
  action     String // 'CREATE' | 'UPDATE' | 'DELETE'
  recordId   String?
  username   String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, tableName, createdAt])
}

enum ConversationType {
  DIRECT
  GROUP
  CROSS_STORE
}

enum MessageType {
  TEXT
  IMAGE
  ORDER_SNIPPET
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  READ
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType @default(DIRECT)
  title       String? // Nama grup (opsional jika direct)
  avatarUrl   String?
  createdById String
  createdBy   User             @relation("CreatedConversations", fields: [createdById], references: [id])
  storeId     String? // Null jika type = CROSS_STORE
  store       Store?           @relation(fields: [storeId], references: [id])
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)

  members  ConversationMember[]
  messages Message[]

  @@index([storeId, updatedAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // "admin" | "member"
  lastReadAt     DateTime     @default(now()) @db.Timestamptz(3)
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  uuid           String        @unique // Client-generated idempotency key
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  content        String?       @db.Text // Teks pesan (bisa null jika hanya kirim foto)
  type           MessageType   @default(TEXT)
  imageUrl       String? // Path / Key file gambar
  imageWidth     Int?
  imageHeight    Int?
  fileSize       Int?
  status         MessageStatus @default(SENT)
  metadata       Json? // Cuplikan info order/nota jika share invoice
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  @@index([conversationId, createdAt])
}
