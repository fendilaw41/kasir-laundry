generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  city      String?
  phone     String?
  featureSubscriptionEnabled Boolean @default(true)
  showUpgradeBanner          Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users           User[]
  products        Product[]
  orders          Order[]
  pelanggan       Pelanggan[]
  inventory       Inventory[]
  inventoryEvents InventoryEvent[]
  settings        Settings?
  syncLogs        SyncLog[]
  conversations   Conversation[]
  subscription    StoreSubscription?
  notifications   Notification[]
}

model User {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  username  String
  password  String // hash bcrypt
  fullname  String
  role      String // 'owner' | 'kasir'
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orders               Order[]
  createdConversations Conversation[]       @relation("CreatedConversations")
  conversationMembers  ConversationMember[]
  sentMessages         Message[]

  @@unique([storeId, username])
  @@index([storeId, updatedAt])
}

model Product {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  code      String?
  category  String?
  name      String
  price     Int
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([storeId, updatedAt])
}

model Pelanggan {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  nama      String
  hp        String
  alamat    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orders Order[]

  @@index([storeId, updatedAt])
}

model Inventory {
  id        String    @id @default(uuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  nama      String
  stok      Int       @default(0)
  qty       Int       @default(0)
  unit      String?
  status    String?
  createdBy String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([storeId, updatedAt])
}

model InventoryEvent {
  id            String    @id @default(uuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  inventoryId   String?
  inventoryName String?
  type          String
  qty           Int       @default(0)
  note          String?
  invoiceId     String?
  createdBy     String?
  kasirPengaju  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  @@index([storeId, updatedAt])
  @@index([storeId, createdAt])
}

model Order {
  id            String     @id @default(uuid())
  storeId       String
  store         Store      @relation(fields: [storeId], references: [id])
  invoiceId     String
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  pelangganId   String?
  pelanggan     Pelanggan? @relation(fields: [pelangganId], references: [id])
  total         Int
  diskon        Int        @default(0)
  bayar         Int        @default(0)
  kembalian     Int        @default(0)
  metodeBayar   String?
  estimasi      String?
  tipeLayanan   String?
  isPriority    Boolean    @default(false)
  statusBayar   String?
  status        String?
  catatan       String?
  catatanKasir  String?
  inventoryUsed Json?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?  @db.Timestamptz(3)

  items OrderItem[]

  @@unique([storeId, invoiceId])
  @@index([storeId, updatedAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  quantity  Float
  price     Int
  subtotal  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

model Settings {
  storeId        String   @id
  store          Store    @relation(fields: [storeId], references: [id])
  namaLaundry    String?
  motto          String?
  alamat         String?
  kota           String?
  telepon        String?
  jamBuka        String?
  menerimaCucian Boolean  @default(true)
  headerStruk    String?
  footerStruk    String?
  storageDriver  String? // 'local' | 's3'
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

model SyncLog {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  tableName  String // 'Order' | 'User' | 'Product' | 'Settings' | 'Pelanggan'
  action     String // 'CREATE' | 'UPDATE' | 'DELETE'
  recordId   String?
  username   String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, tableName, createdAt])
}

enum ConversationType {
  DIRECT
  GROUP
  CROSS_STORE
}

enum MessageType {
  TEXT
  IMAGE
  ORDER_SNIPPET
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  READ
}

model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType @default(DIRECT)
  title       String? // Nama grup (opsional jika direct)
  avatarUrl   String?
  createdById String
  createdBy   User             @relation("CreatedConversations", fields: [createdById], references: [id])
  storeId     String? // Null jika type = CROSS_STORE
  store       Store?           @relation(fields: [storeId], references: [id])
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)

  members  ConversationMember[]
  messages Message[]

  @@index([storeId, updatedAt])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // "admin" | "member"
  lastReadAt     DateTime     @default(now()) @db.Timestamptz(3)
  joinedAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  uuid           String        @unique // Client-generated idempotency key
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id])
  content        String?       @db.Text // Teks pesan (bisa null jika hanya kirim foto)
  type           MessageType   @default(TEXT)
  imageUrl       String? // Path / Key file gambar
  imageWidth     Int?
  imageHeight    Int?
  fileSize       Int?
  status         MessageStatus @default(SENT)
  metadata       Json? // Cuplikan info order/nota jika share invoice
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  @@index([conversationId, createdAt])
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  BASIC
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  GRACE_PERIOD
}

model StoreSubscription {
  id                 String             @id @default(uuid())
  storeId            String             @unique
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @default(TRIAL)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now()) @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @db.Timestamptz(3)
  topupTransactions     Int                @default(0)
  topupPhotos           Int                @default(0)

  // Snapshot Kuota & Limit per Store di DB
  maxTransactions       Int                @default(30)
  usedTransactions      Int                @default(0)
  remainingTransactions Int                @default(30)

  maxChatPhotos         Int                @default(30)
  usedPhotos            Int                @default(0)
  remainingPhotos       Int                @default(30)

  maxUsers              Int                @default(2)
  usedUsers             Int                @default(1)
  remainingUsers        Int                @default(1)

  maxProducts           Int                @default(12)
  usedProducts          Int                @default(0)
  remainingProducts     Int                @default(12)

  maxStockItems         Int                @default(0)
  usedInventory         Int                @default(0)
  remainingInventory    Int                @default(0)

  customBranding        Json?
  notes                 String?
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  @@index([storeId, status])
}

model MasterPlan {
  id                   String   @id @default(uuid())
  key                  String   @unique
  name                 String
  price                Int      @default(0)
  priceLabel           String
  isPopular            Boolean  @default(false)
  maxTransactions      Int      @default(30)
  maxChatPhotos        Int      @default(30)
  botTransactions      Int      @default(0)
  maxPdfInvoice        Int      @default(0)
  customPdfLogo        Boolean  @default(false)
  watermarkTracking    Boolean  @default(true)
  customTrackingView   Boolean  @default(false)
  maxStockItems        Int      @default(0)
  lowStockNotification Boolean  @default(false)
  hasStockHistory      Boolean  @default(false)
  maxOutlets           Int      @default(1)
  maxUsers             Int      @default(2)
  maxProducts          Int      @default(12)
  dataHistoryMonths    Int      @default(1)
  photoRetentionDays   Int      @default(30)
  supportType          String   @default("Panduan")
  badgeColor           String?  @default("secondary")
  sortOrder            Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@index([sortOrder, isActive])
}

model Notification {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  role      String?  // 'owner' | 'kasir' | null (null = broadcast all roles in store)
  title     String
  message   String
  type      String   // 'TRANSACTION' | 'STOCK_APPROVED' | 'PLAN_UPGRADE' | 'LOW_STOCK'
  link      String?  // navigation target URL (e.g. '/order/:id')
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, role, isRead])
}
