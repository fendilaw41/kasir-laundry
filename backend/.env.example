# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE (PostgreSQL / Prisma)
# ==========================================
DATABASE_URL="postgresql://root:password@localhost:5432/kl_db?schema=public"

# ==========================================
# SECURITY & CORS
# ==========================================
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,*"
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# ==========================================
# SYNC & STORE CONFIGURATION
# ==========================================
DEFAULT_STORE_NAME="KASIR LAUNDRY"

# ==========================================
# CHAT & MULTI-STORE CONFIGURATION
# ==========================================
ENABLE_CROSS_STORE_CHAT=true

# ==========================================
# STORAGE DRIVER (LOCAL vs S3/MINIO)
# ==========================================
# Pilihan: 'local' | 's3'
STORAGE_DRIVER="local"

# Konfigurasi S3 / MinIO (jika STORAGE_DRIVER=s3)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="kasir-laundry-chat"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_USE_SSL="false"
S3_FORCE_PATH_STYLE="true"

